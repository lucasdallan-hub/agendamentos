{
  "name": "arena-volei",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --use-env-proxy server.js",
    "dev": "node --use-env-proxy --watch server.js",
    "test": "node --test test/*.test.js",
    "dev:cloudflare": "wrangler dev",
    "build:cloudflare": "wrangler deploy --dry-run --containers-rollout=none --outdir dist/cloudflare",
    "deploy:cloudflare": "wrangler deploy",
    "test:cloudflare": "node scripts/test-cloudflare.mjs",
    "test:cloudflare:containers": "node scripts/test-cloudflare.mjs --with-containers",
    "build": "npm run build:cloudflare"
  },
  "engines": {
    "node": ">=24.5"
  },
  "devDependencies": {
    "@cloudflare/containers": "0.3.7",
    "wrangler": "4.160.1"
  }
}
