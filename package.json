{
  "name": "arena-volei",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --use-env-proxy server.js",
    "dev": "node --use-env-proxy --watch server.js",
    "test": "node --test test/*.test.js",
    "dev:cloudflare": "wrangler dev",
    "build:cloudflare": "wrangler deploy --dry-run --outdir dist/cloudflare",
    "deploy:cloudflare": "wrangler deploy",
    "test:cloudflare": "node scripts/test-cloudflare.mjs",
    "build": "npm run build:cloudflare",
    "setup:cloud": "bash scripts/setup-cloud.sh",
    "dev:cloud": "bash scripts/start-cloud.sh",
    "check:runtime": "node --use-env-proxy scripts/check-runtime.mjs",
    "check:evolution": "node --use-env-proxy scripts/check-evolution-api.mjs"
  },
  "engines": {
    "node": ">=24.5"
  },
  "devDependencies": {
    "wrangler": "4.160.1"
  }
}
