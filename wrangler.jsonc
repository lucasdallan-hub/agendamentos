{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agendamentos",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ARENA",
        "class_name": "Arena"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Arena",
        "ReceiptOCR"
      ]
    }
  ],
  "vars": {
    "MERCADOPAGO_MODE": "test",
    "COOKIE_SECURE": "1"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
